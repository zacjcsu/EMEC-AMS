# ---- Secrets -------------------------------------------------------------
# Written by emecamssetup.sh at install time, mode 600. Never commit.
.env
.env.*
!.env.example

# ---- Per-machine config --------------------------------------------------
# Every Pi has its own machine_id. The setup script writes this file and
# excludes it when syncing code, so it does not belong in git.
# Currently tracked: run `git rm --cached config/config.json` once.
config/config.json

# ---- Runtime state -------------------------------------------------------
# Local SQLite mirror, rebuilt by create_local_db.py on first run.
data/
*.db
*.db-journal
*.sqlite
*.sqlite3

# Keep the logs directory in the repo, ignore its contents. The systemd unit
# appends to logs/errors.log and fails to start if the directory is missing.
logs/*
!logs/.gitkeep

# ---- Virtual environment -------------------------------------------------
# Lives at emec-ams/myvenv on the Pi. Never portable, never committed.
myvenv/
venv/
.venv/
env/

# ---- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---- Editors and OS ------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
